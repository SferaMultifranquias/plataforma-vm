# Browser-safe E2E runtime
E2E_BASE_URL=http://127.0.0.1:3000

# Admin test account
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change-me

# Disposable user config
E2E_TEST_USER_PASSWORD=change-me-too
E2E_TEST_EMAIL_DOMAIN=example.test

# Target environment marker (required for mutations)
# Accepted: local, test, testing, staging, preview
# Rejected: production, prod, live, empty, unknown
# Must be set AND the E2E_ALLOW_LIVE_WRITES/CRUD flag must be true for mutations.
# Never set to a production value.
E2E_TARGET_ENV=test

# Live E2E gates
E2E_ALLOW_LIVE_READS=false
E2E_ALLOW_LIVE_WRITES=false
E2E_ALLOW_LIVE_CRUD=false
