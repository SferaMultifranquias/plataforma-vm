{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true
  },
  "include": [
    "public/**/*.js",
    "tests/**/*.js",
    "scripts/**/*.js",
    "server.js",
    "*.js"
  ],
  "exclude": [
    "node_modules",
    "coverage",
    "dist",
    "test-results",
    "playwright-report"
  ]
}